{
  "name": "system-design-interactive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive System Design laboratory - learn architecture by seeing systems work.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-visuals.mjs && node scripts/check-content.mjs && tsc -b && vite build && node scripts/check-bundle.mjs",
    "start": "serve -s dist -l ${PORT:-3000}",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "check:visuals": "node scripts/check-visuals.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
